@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Listas";
}

@model List<ListaDeCompras.WebApp.ModuloLista.Apresentacao.ListarListasViewModel>
@using ListaDeCompras.WebApp.ModuloLista.Apresentacao


<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma lista cadastrada.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Data de Criação</th>                    
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarListasViewModel l in Model)
                {
                    <tr>
                        <td>@l.Id</td>
                        <td>@l.Nome</td>                        
                        <td>@l.DataCriacao</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@l.Id">Editar</a>
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@l.Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
