@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Categoria";
}

@model ExcluirCategoriaViewModel;

<form class="formulario" action="/Categoria/Excluir/@Model.Id" method="post">

    <p class="formulario-alerta">Deseja mesmo excluir esta Categoria?</p>

    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>

    <div class="formulario-campo">
        <label>Cor</label>
        <br>
        <input type="text" name="Cor" value="@Model.Cor" disabled>
    </div>

    <div class="formulario-acoes">
        <a href="/Categoria/Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>