@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Produto";

    List<SelectListItem> selecionarCategorias = ViewBag.Categorias;
}

@model EditarProdutoViewModel;

<form class="formulario" asp-action="Editar" asp-route-id="@Model.Id" method="post">

    <div class="formulario-campo">
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" type="text">
        <span asp-validation-for="Nome" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="CategoriaId">Categoria</label>
        <select asp-for="CategoriaId" asp-items="selecionarCategorias">
            <option value="">Selecione uma categoria</option>
        </select>
        <span asp-validation-for="CategoriaId" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="UnidadeMedida">Unidade de Medida</label>
        <select asp-for="UnidadeMedida">
            <option value="">Selecione uma unidade</option>
            <option value="Kg">Kg</option>
            <option value="Unidade">Unidade</option>
            <option value="Caixa">Caixa</option>
            <option value="Grama">Grama</option>
        </select>
        <span asp-validation-for="UnidadeMedida" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="PrecoAproximado">Preço Aproximado</label>
        <input asp-for="PrecoAproximado" type="number" step="0.01">
        <span asp-validation-for="PrecoAproximado" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-acoes">
        <a asp-action="Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>