@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Produtos";
}

@model List<ListaDeCompras.WebApp.ModuloProduto.Apresentacao.ListarProdutosViewModel>
@using ListaDeCompras.WebApp.ModuloProduto.Apresentacao


<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma produto cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Categoria</th>                    
                    <th>Unidade</th>                    
                    <th>Preco</th>                    
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarProdutosViewModel p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nome</td>                        
                        <td>@p.Categoria</td>
                        <td>@p.Unidade</td>
                        <td>@p.Preco</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@p.Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
