@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Categoria";
}

@model EditarCategoriaViewModel;

<form class="formulario" action="/Categoria/Cadastrar" method="post">
    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome">
    </div>

    <div class="formulario-campo">
        <label>Cor</label>
        <br>
        <input type="text" name="Cor">
    </div>

    <div class="formulario-acoes">
        <a href="/Categoria/Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>