@using ListaDeCompras.WebApp.ModuloCategoria;

@model List<Categoria>;

<h1>Lista de Compras</h1>

<hr>
<a href="/Categoria/Listar">Controle de Categoria</a>
<hr>

<h2>Listagem de Categorias</h2>

<hr>
<a href="/Categoria/Cadastrar">Cadastrar Novo</a>
<hr>


<hr>
<table>
    <thead>
        <tr>
            <td>ID</td>
            <td>Nome</td>
            <td>Cor</td>
            <td>Ações</td>
        </tr>
    </thead>
    <tbody>
        @foreach (Categoria c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Nome</td>
                <td>@c.Cor</td>
                <td><a href="/Categoria/Editar/@c.Id">Editar</a></td>
                <td><a href="/Categoria/Editar/@c.Id">Excluir</a></td>
            </tr>
        }
    </tbody>
</table>
