@using ListaDeCompras.WebApp.Models
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Categorias";
}

@model List<ListarCategoriasViewModel>;

<a class="btn-cadastrar" href="/Categoria/Cadastrar">Cadastrar Novo</a>

<table class="registros">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Cor</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarCategoriasViewModel c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Nome</td>
                <td>@c.Cor</td>
                <td>
                    <a href="/Categoria/Editar/@c.Id">Editar</a>
                    <a href="/Categoria/Excluir/@c.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
