@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Categoria";
}

@using ListaDeCompras.WebApp.ModuloCategoria;
@model Categoria;

<form action="/Categoria/Excluir/@Model.Id" method="post">
    <div>
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>

    <div>
        <label>Cor</label>
        <br>
        <input type="text" name="Cor" value="@Model.Cor" disabled>
    </div>

    <button type="submit">Confirmar</button>

</form>