@using ListaDeCompras.WebApp.ModuloCategoria;
@model Categoria;

<h1>Lista de Compras</h1>

<hr>
<a href="/Categoria/Listar">Controle de Categoria</a>
<hr>

<h2>Edição de Categorias</h2>

<form action="/Categoria/Editar/@Model.Id" method="post">
    <div>
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome">
    </div>

    <div>
        <label>Cor</label>
        <br>
        <input type="text" name="Cor" value="@Model.Cor">
    </div>

    <button type="submit">Confirmar</button>

</form>