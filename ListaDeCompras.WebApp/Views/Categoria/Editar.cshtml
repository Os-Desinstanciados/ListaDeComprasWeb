@using ListaDeCompras.WebApp.Models;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Categoria";
}

@model EditarCategoriaViewModel;

<form class="formulario" action="/Categoria/Editar/@Model.Id" method="post">
    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome">
    </div>

    <div class="formulario-campo">
        <label>Cor</label>
        <br>
        <input type="text" name="Cor" value="@Model.Cor">
    </div>

    <div class="formulario-acoes">
        <a href="/Categoria/Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>
    
</form>