@using ListaDeCompras.WebApp.Models;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Produto";

    List<ListarCategoriasViewModel> categorias = ViewBag.Categorias;
}

@model EditarProdutoViewModel;

<form class="formulario" action="/Produto/Editar" method="post">

    <input type="hidden" name="Id" value="@Model.Id">

    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome">
    </div>

    <div class="formulario-campo">
        <label>Categoria</label>
        <br>
        <select name="CategoriaId">
            @foreach (ListarCategoriasViewModel c in categorias)
            {
                if (c.Id == Model.CategoriaId)
                {
                    <option value="@c.Id" selected>@c.Nome</option>
                }
                else
                {
                    <option value="@c.Id">@c.Nome</option>
                }
            }
        </select>
    </div>

    <div class="formulario-campo">
        <label>Unidade de Medida</label>
        <br>
        <select name="UnidadeMedida">
            <option value="Kg" selected="@(Model.UnidadeMedida == "Kg")">Kg</option>
            <option value="Unidade" selected="@(Model.UnidadeMedida == "Unidade")">Unidade</option>
            <option value="Caixa" selected="@(Model.UnidadeMedida == "Caixa")">Caixa</option>
            <option value="Grama" selected="@(Model.UnidadeMedida == "Grama")">Grama</option>
        </select>
    </div>

    <div class="formulario-campo">
        <label>Preço Aproximado</label>
        <br>
        <input type="number" name="PrecoAproximado" min="0.01" step="0.01">
    </div>

    <div class="formulario-acoes">
        <a href="/Produto/Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>