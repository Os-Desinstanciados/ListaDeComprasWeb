@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Produtos";
}

@using ListaDeCompras.WebApp.ModuloProduto;

@model List<Produto>;

<a class="btn-cadastrar" href="/Produto/Cadastrar">Cadastrar Novo</a>

<table class="registros">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Unidade</th>
            <th>Preço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Produto p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Categoria.Nome</td>
                <td>@p.UnidadeMedida</td>
                <td>@p.PrecoAproximado</td>
                <td>
                    <a href="/Produto/Editar/@p.Id">Editar</a>
                    <a href="/Produto/Excluir/@p.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>