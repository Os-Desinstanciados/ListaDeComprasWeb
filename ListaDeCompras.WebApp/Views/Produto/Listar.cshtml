@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Produtos";
}

@model List<ListarProdutoViewModel>;

<a class="btn-cadastrar" href="/Produto/Cadastrar">Cadastrar Novo</a>

<table class="registros">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Tipo Unidade</th>
            <th>Preço Aproximado</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarProdutoViewModel p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Categoria</td>
                <td>@p.UnidadeMedida</td>
                <td>@p.PrecoAproximado.ToString(format: "C2")</td>
                <td>
                    <a href="/Produto/Editar/@p.Id">Editar</a>
                    <a href="/Produto/Excluir/@p.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>