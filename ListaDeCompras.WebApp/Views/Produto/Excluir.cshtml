@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Produto";
}

@model ExcluirProdutoViewModel;

<form class="formulario" asp-action="Excluir" asp-route-id="@Model.Id" method="post">

    <p class="formulario-alerta">
        Deseja realmente excluir este produto?
    </p>

    <div class="formulario-campo">
        <label asp-for="Nome">Nome</label>
        <br>
        <input asp-for="Nome" type="text" disabled>
    </div>

    <div class="formulario-campo">
        <label asp-for="Categoria">Categoria</label>
        <br>
        <input asp-for="Categoria" type="text" disabled>
    </div>

    <div class="formulario-campo">
        <label asp-for="UnidadeMedida">Unidade de Medida</label>
        <br>
        <input asp-for="UnidadeMedida" type="text" disabled>
    </div>

    <div class="formulario-campo">
        <label asp-for="PrecoAproximado">Preço Aproximado</label>
        <br>
        <input asp-for="PrecoAproximado" type="number" disabled>
    </div>

    <div class="formulario-acoes">
        <a asp-action="Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>